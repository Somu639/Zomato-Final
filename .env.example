# Groq LLM (Phase 4 — required for AI-ranked recommendations)
GROQ_API_KEY=

# Optional Groq overrides
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=60

# Hugging Face dataset (Phase 1+)
HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation

# Local cache for downloaded dataset
DATASET_CACHE_DIR=data/cache

# Integration / display defaults (Phase 3+)
TOP_K_CANDIDATES=25
DISPLAY_TOP_N=5

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API / web bind address (Phase 5a backend + interim zm serve)
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Railway / cloud sets PORT automatically; zm api and uvicorn use PORT when present
# PORT=10000

# CORS — comma-separated origins (add your Vercel URL for production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

# Phase 6 — caching and rate limiting
RECOMMENDATION_CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=30
